# 솔라피 (https://console.solapi.com) API 키. 실제 값은 Railway Variables에만 넣고 저장소에 올리지 마세요.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 등록된 발신번호 (숫자만)
SOLAPI_SENDER=
# 새 신청 알림 문자를 받을 번호 (여러 개면 쉼표로 구분)
ADMIN_PHONE=
# 신청자 명단을 볼 때 쓰는 관리자 비밀번호 (/admin.html)
ADMIN_KEY=
# 신청 데이터(SQLite) 저장 폴더. Railway에서는 볼륨을 붙이고 그 경로로 지정하세요. 예: /data
DATA_DIR=./data
# (선택) 새 신청 알림을 텔레그램으로도 받기. 둘 다 있어야 보내고, 하나라도 비어 있으면 건너뜁니다.
# 봇 토큰은 @BotFather에서 받은 값이에요. Railway Variables에만 넣고 저장소에 올리지 마세요.
TELEGRAM_BOT_TOKEN=
# 알림을 받을 채팅 ID (봇에게 먼저 아무 메시지나 보내 두세요)
TELEGRAM_CHAT_ID=
